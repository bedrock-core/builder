{
  "name": "@bedrock-core/builder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Composable build planning for TypeScript Bedrock projects",
  "exports": {
    ".": "./src/plan.ts",
    "./config": "./src/config.ts",
    "./runner": {
      "types": "./src/contract.d.ts",
      "default": "./src/run.ts"
    },
    "./manifest": "./src/manifest.ts",
    "./export": "./src/export.ts",
    "./watch": "./src/watch.ts",
    "./schemas/config.schema.json": "./schemas/config.schema.json",
    "./schemas/manifest.schema.json": "./schemas/manifest.schema.json",
    "./schemas/bundler.schema.json": "./schemas/bundler.schema.json",
    "./schemas/generator.schema.json": "./schemas/generator.schema.json",
    "./schemas/i18n.schema.json": "./schemas/i18n.schema.json"
  },
  "scripts": {
    "test": "node --test",
    "plan": "node bin/plan.ts",
    "build": "node bin/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "eslint . --fix --max-warnings=0",
    "check": "yarn lint && yarn typecheck && yarn test",
    "watch": "node bin/watch.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "25.9.9",
    "eslint": "10.5.0",
    "globals": "17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.0"
  },
  "workspaces": [
    "packages/bundler",
    "packages/generator",
    "packages/i18n"
  ],
  "packageManager": "yarn@4.16.0"
}
