{
  "name": "@bedrock-core/builder",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Build one or many Minecraft Bedrock packs from a JavaScript or TypeScript project",
  "exports": {
    ".": "./src/plan.ts",
    "./config": "./src/config.ts",
    "./runner": {
      "types": "./src/contract.d.ts",
      "default": "./src/run.ts"
    },
    "./manifest": "./src/manifest.ts",
    "./export": "./src/export.ts",
    "./watch": "./src/watch.ts",
    "./migrate": "./src/migrate.ts",
    "./validation": "./src/validation.ts",
    "./schemas/config.schema.json": "./schemas/config.schema.json",
    "./schemas/manifest.schema.json": "./schemas/manifest.schema.json",
    "./schemas/bundler.schema.json": "./schemas/bundler.schema.json",
    "./schemas/generator.schema.json": "./schemas/generator.schema.json",
    "./schemas/i18n.schema.json": "./schemas/i18n.schema.json",
    "./schemas/ui-compiler.schema.json": "./schemas/ui-compiler.schema.json",
    "./schemas/guides.schema.json": "./schemas/guides.schema.json"
  },
  "scripts": {
    "test": "node --test",
    "plan": "node bin/plan.ts",
    "build": "node bin/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "eslint . --fix --max-warnings=0",
    "check": "yarn lint && yarn typecheck && yarn test",
    "watch": "node bin/watch.ts",
    "migrate": "node bin/migrate.ts",
    "scaffold": "node packages/cli/src/index.ts",
    "test:cli": "yarn workspace @bedrock-core/cli test",
    "sync:cli": "node scripts/sync-cli-template.mjs",
    "smoke:cli": "node scripts/smoke-cli.mjs",
    "prepare-release": "node scripts/prepare-release.ts",
    "pack-release": "yarn prepare-release && node scripts/pack-release.ts",
    "test:packages": "node scripts/verify-packages.ts",
    "acceptance": "node scripts/acceptance.ts",
    "acceptance:native": "node scripts/acceptance.ts --native",
    "release": "yarn check && yarn acceptance && yarn pack-release && yarn test:packages",
    "publish-release": "node scripts/publish-release.ts",
    "changeset": "changeset",
    "changeset:status": "changeset status --verbose",
    "version:packages": "changeset version"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@bedrock-core/builder-bundler": "workspace:*",
    "@bedrock-core/builder-generator": "workspace:*",
    "@bedrock-core/builder-guides": "workspace:*",
    "@bedrock-core/builder-i18n": "workspace:*",
    "@bedrock-core/builder-manifest": "workspace:*",
    "@bedrock-core/builder-plugin": "workspace:*",
    "@bedrock-core/builder-ui": "workspace:*",
    "@bedrock-core/builder-validation": "workspace:*",
    "@types/node": "25.9.9",
    "ajv": "8.17.1"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "eslint": "10.5.0",
    "globals": "17.7.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.62.0"
  },
  "workspaces": [
    ".",
    "packages/bundler",
    "packages/generator",
    "packages/i18n",
    "packages/ui-compiler",
    "packages/guides",
    "packages/validation",
    "packages/plugin",
    "packages/manifest",
    "packages/cli"
  ],
  "packageManager": "yarn@4.16.0",
  "license": "MIT",
  "files": [
    "dist/**",
    "./README.md",
    "./LICENSE",
    "schemas/**"
  ],
  "publishConfig": {
    "bin": {
      "bc-builder": "./dist/bin/builder.js"
    },
    "exports": {
      "./schemas/config.schema.json": "./schemas/config.schema.json",
      "./export": {
        "types": "./dist/src/export.d.ts",
        "default": "./dist/src/export.js"
      },
      "./watch": {
        "types": "./dist/src/watch.d.ts",
        "default": "./dist/src/watch.js"
      },
      "./schemas/guides.schema.json": "./schemas/guides.schema.json",
      "./migrate": {
        "types": "./dist/src/migrate.d.ts",
        "default": "./dist/src/migrate.js"
      },
      "./schemas/i18n.schema.json": "./schemas/i18n.schema.json",
      "./config": {
        "types": "./dist/src/config.d.ts",
        "default": "./dist/src/config.js"
      },
      "./schemas/manifest.schema.json": "./schemas/manifest.schema.json",
      ".": {
        "types": "./dist/src/plan.d.ts",
        "default": "./dist/src/plan.js"
      },
      "./manifest": {
        "types": "./dist/src/manifest.d.ts",
        "default": "./dist/src/manifest.js"
      },
      "./schemas/bundler.schema.json": "./schemas/bundler.schema.json",
      "./schemas/generator.schema.json": "./schemas/generator.schema.json",
      "./runner": {
        "types": "./dist/src/contract.d.ts",
        "default": "./dist/src/run.js"
      },
      "./schemas/ui-compiler.schema.json": "./schemas/ui-compiler.schema.json",
      "./validation": {
        "types": "./dist/src/validation.d.ts",
        "default": "./dist/src/validation.js"
      }
    },
    "access": "public",
    "tag": "next"
  },
  "bin": {
    "bc-builder": "./bin/builder.ts"
  },
  "private": true
}
