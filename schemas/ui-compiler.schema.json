{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@bedrock-core UI compiler settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "experimentalOre": {
      "type": "object",
      "additionalProperties": false,
      "description": "Asset preparation for Experimental_OreUI screens; ignored when the build has none.",
      "properties": {
        "clientRoot": { "type": "string", "pattern": "\\S", "description": "Windows Minecraft Content directory; defaults to a matching installed client." },
        "resourceRoots": { "type": "array", "items": { "type": "string", "pattern": "\\S" }, "description": "Fallback resource-pack roots after the selected RP, in priority order. Paths resolve from the project." },
        "dynamicTextures": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^textures/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(?:\\.png)?$" }, "description": "Pack-local PNG textures available to live Ore images." }
      }
    },
    "debug": {
      "type": "boolean",
      "description": "Stage override for the profile debug setting."
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Defaults to the project namespace."
    },
    "testMetadata": {
      "type": "boolean",
      "default": false
    },
    "stamp": {
      "type": "boolean",
      "default": false
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      },
      "description": "Additional local or package modules whose default export is a record of screen components."
    },
    "tsconfig": {
      "type": "string",
      "pattern": "\\S"
    },
    "pretty": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indent": {
              "enum": [
                "space",
                "tab"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          }
        }
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "\\S",
      "description": "Configured feature owner pack ID."
    },
    "resourcePack": {
      "type": "string",
      "pattern": "\\S",
      "description": "Direct local resource dependency receiving generated client content."
    }
  }
}
