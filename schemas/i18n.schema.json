{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@bedrock-core i18n settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "debug": {
      "type": "boolean",
      "description": "Stage override for the profile debug setting."
    },
    "sourceDir": {
      "type": "string",
      "pattern": "\\S",
      "default": "i18n",
      "description": "Directory inside each owner pack containing default-exported locale modules; resolved relative to the pack root."
    },
    "defaultLocale": {
      "type": "string",
      "pattern": "^[a-z]{2}_[A-Z]{2}$",
      "default": "en_US"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Defaults to the project's namespace."
    },
    "strict": {
      "type": "boolean",
      "default": true
    },
    "types": {
      "type": "boolean",
      "default": true,
      "description": "Write separate editor declarations under .bedrock-core/generated/i18n/<packId>."
    },
    "vanilla": {
      "type": "boolean",
      "default": false,
      "description": "Fetch and cache vanilla strings, type their keys and bundle referenced values."
    },
    "vanillaLangUrlTemplate": {
      "type": "string",
      "pattern": "\\{locale\\}",
      "description": "Vanilla language URL containing a {locale} placeholder."
    },
    "cacheMaxAgeHours": {
      "type": "number",
      "minimum": 0,
      "default": 24
    },
    "tsconfig": {
      "type": "string",
      "pattern": "\\S"
    },
    "pretty": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indent": {
              "enum": [
                "space",
                "tab"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "owner": {
      "type": "string",
      "pattern": "\\S",
      "description": "Configured feature owner pack ID."
    },
    "resourcePack": {
      "type": "string",
      "pattern": "\\S",
      "description": "Direct local resource dependency receiving generated client content."
    },
    "client": {
      "type": "boolean",
      "default": true,
      "description": "False emits runtime data without language files."
    }
  }
}
