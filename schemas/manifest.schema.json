{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@bedrock-core manifest settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifestPath": {
      "description": "Project-relative manifest source, or one source per configured pack. Unselected packs use manifest.json. Relative extends chains are resolved and pack-root manifest variants are removed from staging.",
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      ]
    },
    "pretty": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indent": {
              "enum": [
                "tab",
                "space"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "debug": {
      "type": "boolean",
      "description": "Stage override for the profile debug setting."
    }
  }
}
