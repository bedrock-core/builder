{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@bedrock-core project configuration",
  "description": "Minecraft Bedrock project metadata and @bedrock-core profiles.",
  "type": "object",
  "required": [
    "targetVersion",
    "namespace",
    "name",
    "authors",
    "packs",
    "bedrockCore"
  ],
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "targetVersion": {
      "$ref": "#/definitions/nonempty"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "not": {
        "const": "minecraft"
      }
    },
    "name": {
      "$ref": "#/definitions/nonempty"
    },
    "description": {
      "type": "string"
    },
    "authors": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "logo": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "experimentalGameplay": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "packs": {
      "type": "object",
      "minProperties": 1,
      "description": "Named pack paths. Manifest modules determine pack type, not names.",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/nonempty"
      }
    },
    "packDefinitions": {
      "type": "object",
      "properties": {
        "families": {
          "$ref": "#/definitions/packDefinition"
        },
        "tags": {
          "$ref": "#/definitions/packDefinition"
        },
        "scoreboardObjectives": {
          "$ref": "#/definitions/packDefinition"
        },
        "names": {
          "$ref": "#/definitions/packDefinition"
        }
      }
    },
    "bedrockCore": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "profiles"
      ],
      "properties": {
        "formatVersion": {
          "const": "1.0.0"
        },
        "plugins": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/definitions/nonempty"
          },
          "additionalProperties": {
            "$ref": "#/definitions/plugin"
          }
        },
        "profiles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/definitions/nonempty"
          },
          "additionalProperties": {
            "$ref": "#/definitions/profile"
          }
        }
      }
    }
  },
  "definitions": {
    "pretty": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indent": {
              "enum": [
                "tab",
                "space"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "nonempty": {
      "type": "string",
      "pattern": "\\S"
    },
    "plugin": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "module"
          ],
          "properties": {
            "module": {
              "$ref": "#/definitions/nonempty",
              "description": "Local TS/JS module or npm package exporting run(context, settings)."
            },
            "targets": {
              "$ref": "#/definitions/pluginTargets"
            },
            "scope": {
              "enum": [
                "pack",
                "project"
              ],
              "description": "Targeted module plugins run per pack unless project scope is selected."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "script"
          ],
          "not": {
            "required": [
              "targets",
              "packs"
            ]
          },
          "properties": {
            "script": {
              "$ref": "#/definitions/nonempty",
              "description": "Standalone Node entry point, relative to filterDir, using the Regolith BP/RP/data contract."
            },
            "targets": {
              "$ref": "#/definitions/pluginTargets"
            },
            "filterDir": {
              "$ref": "#/definitions/nonempty",
              "description": "Script definition directory, relative to config.json. Defaults to the project root and sets FILTER_DIR."
            },
            "dataPath": {
              "$ref": "#/definitions/nonempty",
              "description": "Project directory copied into shared staged data. Defaults to ./data when present."
            },
            "packs": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": false,
              "properties": {
                "BP": {
                  "$ref": "#/definitions/nonempty"
                },
                "RP": {
                  "$ref": "#/definitions/nonempty"
                }
              },
              "description": "Conventional folders mapped to configured pack IDs. Omission infers one behavior and one resource pack."
            },
            "nodeArguments": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Node flags before the script, such as loader flags."
            }
          }
        }
      ]
    },
    "pluginTargets": {
      "anyOf": [
        {
          "enum": [
            "resource",
            "behavior",
            "both"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "packs": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/nonempty"
              }
            },
            "modules": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/definitions/nonempty"
              }
            }
          }
        }
      ],
      "description": "Select pack IDs intersected with any-of module capabilities. Each pack is selected once."
    },
    "packDefinition": {
      "type": "object",
      "required": [
        "include",
        "exclude"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stage": {
      "anyOf": [
        {
          "const": "auto"
        },
        {
          "type": "boolean"
        },
        {
          "type": "object"
        }
      ],
      "description": "Omission or auto detects inputs; false disables; true or settings enables the stage even without detected inputs."
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pretty": {
          "$ref": "#/definitions/pretty",
          "description": "Generated JSON formatting inherited by stages; an explicit stage value replaces it."
        },
        "debug": {
          "type": "boolean",
          "description": "Debug output inherited by stages that use it; an explicit stage value replaces it."
        },
        "export": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/nonempty"
          },
          "description": "Map each configured pack ID to its exact destination folder. Paths resolve relative to config.json; absolute paths and environment variables (%VAR%, $VAR, ${VAR}) are supported. Unset or empty variables fail before plugins execute."
        },
        "stages": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "manifest": {
              "anyOf": [
                {
                  "const": "auto"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "./manifest.schema.json"
                }
              ],
              "description": "Omission or auto detects inputs; false disables; true or settings enables the stage even without detected inputs."
            },
            "generator": {
              "anyOf": [
                {
                  "const": "auto"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "./generator.schema.json"
                }
              ],
              "description": "Omission or auto detects inputs; false disables; true or settings enables the stage even without detected inputs."
            },
            "guides": {
              "anyOf": [
                {
                  "const": "auto"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "./guides.schema.json"
                }
              ]
            },
            "i18n": {
              "anyOf": [
                {
                  "const": "auto"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "./i18n.schema.json"
                }
              ],
              "description": "Omission or auto detects inputs; false disables; true or settings enables the stage even without detected inputs."
            },
            "ui-compiler": {
              "anyOf": [
                {
                  "const": "auto"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "./ui-compiler.schema.json"
                }
              ]
            },
            "bundler": {
              "anyOf": [
                {
                  "const": "auto"
                },
                {
                  "type": "boolean"
                },
                {
                  "$ref": "./bundler.schema.json"
                }
              ],
              "description": "Omission or auto detects inputs; false disables; true or settings enables the stage even without detected inputs."
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/step"
          }
        },
        "watch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "debounceMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "paths": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/nonempty"
              }
            }
          }
        },
        "cache": {
          "type": "boolean",
          "default": true,
          "description": "Reuse deterministic compiler output when its inputs match. Set false to rebuild it."
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin"
      ],
      "oneOf": [
        {
          "required": [
            "before"
          ]
        },
        {
          "required": [
            "after"
          ]
        }
      ],
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "always"
          ],
          "description": "Module plugins use their optional detect(context, settings) in auto mode. Omission always runs the step."
        },
        "plugin": {
          "$ref": "#/definitions/nonempty"
        },
        "before": {
          "enum": [
            "manifest",
            "generator",
            "guides",
            "i18n",
            "ui-compiler",
            "bundler",
            "export"
          ]
        },
        "after": {
          "enum": [
            "prepare",
            "manifest",
            "generator",
            "guides",
            "i18n",
            "ui-compiler",
            "bundler"
          ]
        },
        "settings": {
          "type": "object"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Script arguments following nonempty JSON settings. With empty settings, they start at argv[2]."
        }
      }
    }
  }
}
