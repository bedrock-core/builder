{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@bedrock-core generator settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "debug": {
      "type": "boolean",
      "description": "Stage override for the profile debug setting."
    },
    "include": {
      "$ref": "#/$defs/patterns"
    },
    "exclude": {
      "$ref": "#/$defs/patterns"
    },
    "tsconfig": {
      "type": "string",
      "pattern": "\\S"
    },
    "generatedImports": {
      "type": "object",
      "description": "Optional overrides or custom artifact aliases. Producer import names resolve automatically.",
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "pretty": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indent": {
              "enum": [
                "tab",
                "space"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "patterns": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "\\S"
        },
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      ]
    }
  }
}
