{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@bedrock-core bundler settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pretty": {
      "anyOf": [
        {
          "const": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "indent": {
              "enum": [
                "tab",
                "space"
              ]
            },
            "size": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      ]
    },
    "debug": {
      "type": "boolean"
    },
    "target": {
      "type": "string",
      "pattern": "\\S"
    },
    "tsconfig": {
      "type": "string",
      "pattern": "\\S"
    },
    "external": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "generatedImports": {
      "type": "object",
      "description": "Optional overrides or custom artifact aliases. Producer import names resolve automatically.",
      "additionalProperties": {
        "type": "string",
        "pattern": "\\S"
      }
    }
  }
}
