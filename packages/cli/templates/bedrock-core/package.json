{
	"name": "{{PROJECT_NAME}}",
	"version": "1.0.0",
	"main": "main.js",
	"exports": {
		"./manifest.json": "./packs/BP/manifest.json"
	},
	"scripts": {
		"build": "bc-builder build config.json build",
		"build:test": "bc-builder build config.json build-test",
		"watch": "bc-builder watch config.json default",
		"watch:test": "bc-builder watch config.json test",
		"lint": "eslint .",
		"loopback": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-1958404141-86561845-1752920682-3514627264-368642714-62675701-733520436",
		"loopback:preview": "CheckNetIsolation.exe LoopbackExempt -a -p=S-1-15-2-424268864-5579737-879501358-346833251-474568803-887069379-4040235476",
		"plan": "bc-builder plan config.json",
		"typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
		"test:mc": "bc-builder build config.json build-test && bc-bds run --packs build/test --tag example --expect-registered 1",
		"build:optimized": "bc-builder build config.json build-optimized && bc-bds optimize --packs build/production --out dist",
		"bds:fetch": "bc-bds fetch",
		"bds:where": "bc-bds where"
	},
	"dependencies": {
		"@bedrock-core/catalog": "^0.3.0",
		"@bedrock-core/config": "^0.5.0",
		"@bedrock-core/guides": "^0.4.1",
		"@bedrock-core/i18n": "^0.3.0",
		"@bedrock-core/observable": "^1.1.0",
		"@bedrock-core/server": "^0.3.0",
		"@bedrock-core/navigation": "0.14.0",
		"@bedrock-core/ore-styled": "0.11.3",
		"@bedrock-core/ui": "0.15.0",
		"@bedrock-core/ui-runtime": "0.15.0",
		"@minecraft/common": "1.2.0",
		"@minecraft/server": "2.10.0",
		"@minecraft/server-ui": "2.2.0",
		"@minecraft/vanilla-data": "1.26.50"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@eslint/json": "^2.0.0",
		"@minecraft/server-gametest": "1.0.0-beta.1.26.50-stable",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.3.0",
		"eslint-plugin-minecraft-linting": "^2.0.12",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
