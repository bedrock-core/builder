{
	"$schema": "https://bedrock-core.drav.dev/schemas/builder/beta/pack-manifest.schema.json",
  "format_version": 3,
  "namespace": "{{CREATOR_ID}}_{{PACK_ID}}",
  "header": {
    "name": "pack.name",
    "description": "pack.description",
    "uuid": "{{RP_HEADER_UUID}}",
    "pack_scope": "world"
  },
  "modules": [
    {
      "type": "resources",
      "uuid": "{{RP_MODULE_UUID}}"
    }
  ],
  "dependencies": [
    {
      "namespace": "{{CREATOR_ID}}_{{PACK_ID}}"
    }
  ],
  "metadata": {
    "product_type": "addon"
  }
}
