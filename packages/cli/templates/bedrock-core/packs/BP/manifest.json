{
	"format_version": 3,
	"$schema": "https://bedrock-core.drav.dev/schemas/builder/beta/pack-manifest.schema.json",
	"namespace": "{{CREATOR_ID}}_{{PACK_ID}}",
	"header": {
		"name": "pack.name",
		"description": "pack.description",
		"uuid": "{{BP_HEADER_UUID}}",
		"pack_scope": "world"
	},
	"modules": [
		{
			"type": "data",
			"uuid": "{{BP_DATA_UUID}}"
		},
		{
			"type": "script",
			"language": "javascript",
			"uuid": "{{BP_SCRIPT_UUID}}",
			"entry": "scripts/main.ts"
		}
	],
	"dependencies": [
		{
			"namespace": "{{CREATOR_ID}}_{{PACK_ID}}"
		},
		{
			"uuid": "761ecd37-ad1c-4a64-862a-d6cc38767426",
			"version": "1.14.0"
		},
		{
			"module_name": "@minecraft/server"
		},
		{
			"module_name": "@minecraft/server-ui"
		}
	],
	"metadata": {
		"product_type": "addon"
	}
}
