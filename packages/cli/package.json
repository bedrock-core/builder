{
	"name": "@bedrock-core/cli",
	"version": "0.12.1",
	"description": "Scaffold Minecraft Bedrock projects with @bedrock-core/builder",
	"keywords": [
		"cli",
		"scaffold",
		"ui",
		"minecraft",
		"bedrock",
		"addon",
		"generator"
	],
	"license": "MIT",
	"author": "DrAv0011",
	"contributors": [
		{
			"name": "DrAv0011",
			"email": "contact@drav.dev",
			"url": "https://drav.dev"
		}
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bedrock-core/builder.git",
		"directory": "packages/cli"
	},
	"engines": {
		"node": ">=22.18"
	},
	"type": "module",
	"bin": "./dist/index.js",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist",
		"templates",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"test": "npm run test:offline",
		"test:offline": "node --test test/offline.test.mjs",
		"lint": "eslint .",
		"prepack": "npm run build"
	},
	"dependencies": {
		"chalk": "^5.6.2",
		"commander": "^14.0.3",
		"fs-extra": "^11.3.5",
		"ora": "^9.4.0",
		"prompts": "^2.4.2",
		"validate-npm-package-name": "^7.0.2"
	},
	"devDependencies": {
		"@types/fs-extra": "^11.0.4",
		"@types/node": "25.9.9",
		"@types/prompts": "^2.4.9",
		"@types/validate-npm-package-name": "^4.0.2",
		"eslint": "10.5.0",
		"typescript": "5.9.3"
	}
}
