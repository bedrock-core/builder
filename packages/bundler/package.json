{
  "name": "@bedrock-core/builder-bundler",
  "version": "0.3.0",
  "type": "module",
  "description": "Standalone TS/JS script bundling for @bedrock-core projects",
  "exports": {
    ".": "./src/index.ts",
    "./dependencies": "./src/dependencies.ts",
    "./plugin": "./src/plugin.ts",
    "./compile": "./src/compile.ts",
    "./entries": "./src/entries.ts",
    "./assets": "./src/vanilla.ts"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "dependencies": {
    "@bedrock-core/bedrock-types": "workspace:*",
    "@bedrock-core/builder-manifest": "workspace:*",
    "@bedrock-core/builder-plugin": "workspace:*",
    "esbuild": "0.25.12",
    "jsonc-parser": "3.3.1",
    "typescript-native": "npm:typescript@7.1.0-beta",
    "yauzl": "3.4.0"
  },
  "license": "MIT",
  "files": [
    "dist/**",
    "./README.md",
    "./LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./dependencies": {
        "types": "./dist/src/dependencies.d.ts",
        "default": "./dist/src/dependencies.js"
      },
      "./plugin": {
        "types": "./dist/src/plugin.d.ts",
        "default": "./dist/src/plugin.js"
      },
      "./compile": {
        "types": "./dist/src/compile.d.ts",
        "default": "./dist/src/compile.js"
      },
      "./entries": {
        "types": "./dist/src/entries.d.ts",
        "default": "./dist/src/entries.js"
      },
      "./assets": {
        "types": "./dist/src/vanilla.d.ts",
        "default": "./dist/src/vanilla.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedrock-core/builder.git",
    "directory": "packages/bundler"
  }
}
