{
  "name": "@bedrock-core/builder-bundler",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "Standalone TS/JS script bundling for @bedrock-core projects",
  "exports": {
    ".": "./src/index.ts",
    "./dependencies": "./src/dependencies.ts",
    "./plugin": "./src/plugin.ts",
    "./compile": "./src/compile.ts",
    "./entries": "./src/entries.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@bedrock-core/builder-manifest": "workspace:*",
    "@bedrock-core/builder-plugin": "workspace:*",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "files": [
    "dist/**",
    "./README.md",
    "./LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./dependencies": {
        "types": "./dist/src/dependencies.d.ts",
        "default": "./dist/src/dependencies.js"
      },
      "./plugin": {
        "types": "./dist/src/plugin.d.ts",
        "default": "./dist/src/plugin.js"
      },
      "./compile": {
        "types": "./dist/src/compile.d.ts",
        "default": "./dist/src/compile.js"
      },
      "./entries": {
        "types": "./dist/src/entries.d.ts",
        "default": "./dist/src/entries.js"
      }
    },
    "access": "public",
    "tag": "next"
  },
  "private": true
}
