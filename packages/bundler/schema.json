{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "@bedrock-core bundler settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pack": { "type": "string", "pattern": "\\S", "description": "Named destination. Omit when exactly one behavior pack exists." },
    "entry": {
      "type": "string",
      "pattern": "\\S",
      "description": "TS/JS entry relative to config.json; required for execution."
    },
    "outfile": {
      "type": "string",
      "pattern": "\\S",
      "description": "Path relative to the behavior pack. Defaults to scripts/main.js."
    },
    "debug": { "type": "boolean" },
    "target": { "type": "string", "pattern": "\\S" },
    "tsconfig": { "type": "string", "pattern": "\\S" },
    "external": { "type": "array", "items": { "type": "string", "pattern": "\\S" } },
    "generatedImports": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "\\S" }
    }
  }
}
