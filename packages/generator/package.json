{
  "name": "@bedrock-core/builder-generator",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone typed TS/JS content generation for @bedrock-core projects",
  "exports": {
    ".": "./src/index.ts",
    "./templates": "./src/templates.ts",
    "./plugin": "./src/plugin.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@bedrock-core/builder-bundler": "workspace:*",
    "@bedrock-core/builder-plugin": "workspace:*",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "files": [
    "dist/**",
    "./README.md",
    "./LICENSE"
  ],
  "publishConfig": {
    "exports": {
      "./templates": {
        "types": "./dist/src/templates.d.ts",
        "default": "./dist/src/templates.js"
      },
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./plugin": {
        "types": "./dist/src/plugin.d.ts",
        "default": "./dist/src/plugin.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedrock-core/builder.git",
    "directory": "packages/generator"
  }
}
