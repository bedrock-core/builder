{
  "name": "@bedrock-core/builder-validation",
  "version": "0.2.0",
  "type": "module",
  "description": "Standalone pack content validation against native Bedrock document types",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=26.13.0"
  },
  "dependencies": {
    "@bedrock-core/bedrock-types": "workspace:*",
    "jsonc-parser": "3.3.1",
    "typescript-native": "npm:typescript@7.1.0-dev.20261127.1"
  },
  "license": "MIT",
  "files": [
    "dist/**",
    "./README.md",
    "./LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedrock-core/builder.git",
    "directory": "packages/validation"
  }
}
