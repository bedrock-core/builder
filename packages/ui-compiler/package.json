{
  "name": "@bedrock-core/builder-ui",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "UI build integration using the addon's @bedrock-core compiler",
  "exports": {
    ".": "./src/index.ts",
    "./transform": "./src/sugar.ts",
    "./internal/*": "./src/*.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@bedrock-core/builder-bundler": "workspace:*",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "files": [
    "dist/**",
    "./README.md",
    "./LICENSE"
  ],
  "publishConfig": {
    "exports": {
      "./transform": {
        "types": "./dist/src/sugar.d.ts",
        "default": "./dist/src/sugar.js"
      },
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./internal/*": {
        "types": "./dist/src/*.d.ts",
        "default": "./dist/src/*.js"
      }
    },
    "access": "public",
    "tag": "next"
  },
  "private": true
}
