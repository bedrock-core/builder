{
  "name": "@bedrock-core/builder-ui",
  "version": "0.1.0-alpha.0",
  "type": "module",
  "description": "UI build integration using the addon's @bedrock-core compiler",
  "exports": {
    ".": "./src/index.ts",
    "./plugin": "./src/plugin.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@bedrock-core/builder-bundler": "workspace:*",
    "@bedrock-core/builder-manifest": "workspace:*",
    "@bedrock-core/builder-plugin": "workspace:*",
    "esbuild": "0.25.12",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "files": [
    "dist/**",
    "./README.md",
    "./LICENSE"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/src/index.d.ts",
        "default": "./dist/src/index.js"
      },
      "./plugin": {
        "types": "./dist/src/plugin.d.ts",
        "default": "./dist/src/plugin.js"
      }
    },
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bedrock-core/builder.git",
    "directory": "packages/ui-compiler"
  }
}
