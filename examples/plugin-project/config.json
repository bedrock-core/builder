{
  "$schema": "../../schemas/config.schema.json",
  "targetVersion": "1.26.50",
  "namespace": "builder_example",
  "name": "@bedrock-core plugin example",
  "authors": [],
  "packs": {
    "behaviorPack": "./packs/BP"
  },
  "bedrockCore": {
    "formatVersion": "1.0.0",
    "plugins": {
      "items": {
        "module": "./build/items.ts"
      }
    },
    "profiles": {
      "default": {
        "steps": [
          {
            "plugin": "items",
            "after": "prepare"
          },
          {
            "plugin": "items",
            "before": "export",
            "settings": {
              "consume": true
            }
          }
        ],
        "export": {
          "behaviorPack": "./dist/behaviorPack"
        }
      }
    }
  }
}
