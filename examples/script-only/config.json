{
  "$schema": "../../schemas/config.schema.json",
  "type": "minecraftBedrock",
  "name": "Script-only example",
  "authors": [],
  "targetVersion": "1.26.50",
  "namespace": "builder_example",
  "packs": {
    "behaviorPack": "./packs/BP"
  },
  "worlds": [],
  "bedrockCore": {
    "formatVersion": "1.0.0",
    "profiles": {
      "default": {
        "stages": {
          "bundler": {
            "debug": true
          }
        },
        "export": {
          "target": "local",
          "path": "./dist"
        }
      },
      "tests": {
        "stages": {
          "manifest": {
            "packs": {
              "behaviorPack": {
                "scriptEntry": "scripts/tests.js"
              }
            }
          },
          "bundler": {
            "debug": true
          }
        },
        "export": {
          "path": "./dist/tests"
        }
      }
    }
  }
}
