{
  "$schema": "../../schemas/config.schema.json",
  "targetVersion": "1.26.50",
  "namespace": "builder_example",
  "name": "Script-only example",
  "authors": [],
  "packs": {
    "behaviorPack": "./packs/BP"
  },
  "bedrockCore": {
    "formatVersion": "1.0.0",
    "profiles": {
      "default": {
        "stages": {
          "bundler": {
            "debug": true
          }
        },
        "export": {
          "behaviorPack": "./dist/behaviorPack"
        }
      },
      "tests": {
        "stages": {
          "manifest": {
            "packs": {
              "behaviorPack": {
                "scriptEntry": "scripts/tests.js"
              }
            }
          },
          "bundler": {
            "debug": true
          }
        },
        "export": {
          "behaviorPack": "./dist/tests/behaviorPack"
        }
      }
    }
  }
}
