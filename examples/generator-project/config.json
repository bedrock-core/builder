{
  "$schema": "../../schemas/config.schema.json",
  "type": "minecraftBedrock",
  "name": "@bedrock-core generator example",
  "authors": [],
  "targetVersion": "1.26.50",
  "namespace": "builder_generator",
  "packs": {
    "gameplay": "./packs/gameplay"
  },
  "worlds": [],
  "bedrockCore": {
    "formatVersion": "1.0.0",
    "profiles": {
      "default": {
        "stages": {
          "generator": {
            "pretty": {
              "indent": "space",
              "size": 2
            }
          },
          "bundler": {
            "debug": true
          }
        },
        "export": {
          "path": "./dist"
        }
      }
    }
  }
}
