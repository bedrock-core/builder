{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["packs/**/*.ts", "shared/**/*.ts", ".bedrock-core/generated/i18n/**/*.d.ts"],
  "exclude": ["dist", "node_modules"]
}
